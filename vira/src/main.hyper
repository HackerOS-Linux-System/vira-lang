import { existsSync, mkdirSync, writeFileSync } from "fs"
import { ConsoleReporter } from "./reporter.hyper"
import { Manifest, loadManifest, loadManifestRaw, saveManifestRaw, discoverWorkspace } from "./manifest.hyper"
import { resolvePackage, detectRegistry, stripRegistryPrefix, searchNpm, searchJsr } from "./registry.hyper"
import { writeLockfile } from "./lockfile.hyper"
import { downloadPackage } from "./download.hyper"
import { cmdBuild } from "./build.hyper"
import { cmdRun } from "./run.hyper"
import { cmdCheck } from "./check.hyper"
import { cmdFmt } from "./fmt.hyper"
import { cmdLsp } from "./lsp.hyper"
import { cmdPublish } from "./publish.hyper"

async fn resolveAllDeps(manifest: Manifest, reporter: ConsoleReporter) -> any {
    let mut lock = []
    let names = Object.keys(manifest.dependencies)
    for name in names {
        let registry = detectRegistry(name)
        let cleanName = stripRegistryPrefix(name)
        let range = manifest.dependencies[name] ?? "*"
        reporter.info(`rozwiązywanie ${cleanName} (${registry}, zakres ${range})...`)
        let pkg = await resolvePackage(cleanName, registry, range)
        await downloadPackage(pkg, reporter)
        lock.push(pkg)
        reporter.info(`${pkg.name}@${pkg.version} rozwiązany i pobrany`)
    }
    return lock
}

async fn cmdInstall(args: any) {
    let reporter = ConsoleReporter { prefix: "[vira]" }
    if !existsSync("vira.yml") {
        reporter.error("nie znaleziono vira.yml w bieżącym katalogu")
        return
    }

    // `vira install <pkg>` (z opcjonalnym prefiksem "jsr:"/"vira:") dopisuje
    // jedną nową zależność do manifestu przed rozwiązaniem wszystkich.
    if args.length > 0 {
        let spec = args[0]
        let registry = detectRegistry(spec)
        let cleanName = stripRegistryPrefix(spec)
        reporter.info(`dodawanie ${cleanName} (${registry})...`)
        let pkg = await resolvePackage(cleanName, registry, "*")

        let raw = loadManifestRaw("vira.yml")
        let versionSpec = registry == "vira" ? pkg.resolved : `^${pkg.version}`
        raw.dependencies[spec] = versionSpec
        saveManifestRaw("vira.yml", raw)
        reporter.info(`dodano ${pkg.name}@${pkg.version} do vira.yml`)
    }

    let manifest = loadManifest("vira.yml")
    reporter.info(`instalacja zależności dla ${manifest.name}@${manifest.version}`)

    let workspace = discoverWorkspace(manifest, reporter)
    for member in workspace {
        reporter.info(`workspace member: ${member.name}@${member.version}`)
    }

    let lock = await resolveAllDeps(manifest, reporter)
    writeLockfile(lock, "vira.lock")
    reporter.info(`gotowe - zapisano vira.lock (${lock.length} pakietów)`)
}

fn cmdRemove(args: any) {
    let reporter = ConsoleReporter { prefix: "[vira]" }
    if args.length == 0 {
        reporter.error("użycie: vira remove <pakiet>")
        return
    }
    if !existsSync("vira.yml") {
        reporter.error("nie znaleziono vira.yml w bieżącym katalogu")
        return
    }
    let name = args[0]
    let raw = loadManifestRaw("vira.yml")
    if raw.dependencies[name] == null {
        reporter.error(`'${name}' nie jest zależnością tego projektu`)
        return
    }
    Reflect.deleteProperty(raw.dependencies, name)
    saveManifestRaw("vira.yml", raw)
    reporter.info(`usunięto ${name} z vira.yml (uruchom 'vira install' żeby odświeżyć vira.lock)`)
}

async fn cmdSearch(args: any) {
    let reporter = ConsoleReporter { prefix: "[vira]" }
    if args.length == 0 {
        reporter.error("użycie: vira search <zapytanie> [--registry jsr]")
        return
    }
    let query = args[0]
    let useJsr = args.includes("--registry") && args[args.indexOf("--registry") + 1] == "jsr"

    if useJsr {
        let results = await searchJsr(query)
        for pkg in results {
            console.log(`${pkg.scope}/${pkg.name} - ${pkg.description ?? ""}`)
        }
        return
    }

    let results = await searchNpm(query)
    for entry in results {
        let pkg = entry.package
        console.log(`${pkg.name}@${pkg.version} - ${pkg.description ?? ""}`)
    }
}

fn cmdNew(name: string) {
    mkdirSync(name)
    mkdirSync(`${name}/src`)
    writeFileSync(`${name}/vira.yml`, `package:
  name: ${name}
  version: 0.1.0

dependencies:
`)
    writeFileSync(`${name}/src/main.hyper`, `fn main() {
  console.log("Hello from ${name}!")
}

main()
`)
    console.log(`vira: utworzono nowy projekt w ./${name}`)
}

fn printHelp() {
    console.log("vira - menedżer pakietów i budowania Hyper Lang")
    console.log("")
    console.log("Użycie:")
    console.log("  vira new <nazwa>              tworzy nowy projekt")
    console.log("  vira install [pakiet]         instaluje zależności (albo dodaje jedną)")
    console.log("  vira remove <pakiet>          usuwa zależność z vira.yml")
    console.log("  vira search <zapytanie>       szuka w npm (--registry jsr dla JSR)")
    console.log("  vira check                    parsuje i sprawdza typy, bez emisji JS")
    console.log("  vira fmt [--check]            formatuje pliki .hyper w src/")
    console.log("  vira build [--release]        transpiluje do .js, albo buduje binarkę")
    console.log("  vira run [--release]          uruchamia projekt (node albo binarka)")
    console.log("  vira lsp                      uruchamia serwer LSP (dla edytora)")
    console.log("  vira publish [--registry jsr|npm|all]  publikuje zbudowany pakiet")
    console.log("")
    console.log("Przykłady:")
    console.log("  vira install left-pad")
    console.log("  vira install jsr:@luca/cases")
    console.log("  vira install vira:nidus")
    console.log("  vira build --release")
}

async fn main() {
    let args = process.argv.slice(2)
    let cmd = args[0] ?? "help"
    let rest = args.slice(1)

    if cmd == "install" {
        await cmdInstall(rest)
    } else if cmd == "remove" {
        cmdRemove(rest)
    } else if cmd == "search" {
        await cmdSearch(rest)
    } else if cmd == "new" {
        let name = rest[0]
        if name == null {
            console.error("vira: użycie: vira new <nazwa>")
            return
        }
        cmdNew(name)
    } else if cmd == "check" {
        let reporter = ConsoleReporter { prefix: "[vira]" }
        cmdCheck(reporter)
    } else if cmd == "fmt" {
        let reporter = ConsoleReporter { prefix: "[vira]" }
        cmdFmt(rest, reporter)
    } else if cmd == "build" {
        let reporter = ConsoleReporter { prefix: "[vira]" }
        let manifest = loadManifest("vira.yml")
        await cmdBuild(rest, manifest, reporter)
    } else if cmd == "run" {
        let reporter = ConsoleReporter { prefix: "[vira]" }
        let manifest = loadManifest("vira.yml")
        cmdRun(rest, manifest, reporter)
    } else if cmd == "lsp" {
        cmdLsp()
    } else if cmd == "publish" {
        let reporter = ConsoleReporter { prefix: "[vira]" }
        let manifest = loadManifest("vira.yml")
        await cmdPublish(rest, manifest, reporter)
    } else {
        printHelp()
    }
}

main().catch((err) => { console.error(err) })
