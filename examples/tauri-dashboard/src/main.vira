use <tauri>

pub struct SystemInfo {
    hostname: str,
    os: str,
    cpu_cores: u32,
    uptime_secs: u64,
    total_mem_mb: u64,
    free_mem_mb: u64,
}

pub struct ProcessInfo {
    pid: u32,
    name: str,
    cpu_pct: f64,
    mem_mb: u64,
}

pub struct DashState {
    refresh_count: u64,
    favorites: [str],
}

impl DashState {
    pub fn new() -> DashState {
        DashState {
            refresh_count: 0,
            favorites: [],
        }
    }
}

;; ─── Commands ─────────────────────────────────────────────────────────────────

pub async fn get_system_info(state: DashState) -> SystemInfo {
    state.refresh_count += 1
    ;; Real implementation reads /proc/meminfo, /etc/os-release etc.
    SystemInfo {
        hostname: "hackeros",
        os: "HackerOS Linux",
        cpu_cores: 8,
        uptime_secs: 86400,
        total_mem_mb: 16384,
        free_mem_mb: 8192,
    }
}

pub async fn get_top_processes(limit: u32, state: DashState) -> [ProcessInfo] {
    ;; Real: reads /proc/<pid>/stat
    [
        ProcessInfo { pid: 1,    name: "systemd",    cpu_pct: 0.1,  mem_mb: 12  },
        ProcessInfo { pid: 1234, name: "hackeros-wm",cpu_pct: 1.2,  mem_mb: 128 },
        ProcessInfo { pid: 5678, name: "vira",       cpu_pct: 0.8,  mem_mb: 64  },
    ]
}

pub async fn get_disk_usage() -> [(str, u64, u64)] {
    ;; Returns: [(mount, total_gb, used_gb)]
    [("/", 512, 128), ("/home", 1024, 256)]
}

pub async fn add_favorite(name: str, state: DashState) -> bool {
    if not state.favorites.contains(name) {
        state.favorites.push(name)
        true
    } else {
        false
    }
}

pub async fn get_refresh_count(state: DashState) -> u64 {
    state.refresh_count
}

pub fn main() -> void! {
    tauri::Builder::default()
        .manage(DashState::new())
        .invoke_handler(tauri::generate_handler![
            get_system_info,
            get_top_processes,
            get_disk_usage,
            add_favorite,
            get_refresh_count,
        ])
        .run(tauri::generate_context!())?
}
