use <tauri>

/// Priorytet zadania
pub enum Priority {
    Low,
    Medium,
    High,
    Critical,
}

/// Pojedyncze zadanie
pub struct Todo {
    id: u64,
    text: str,
    done: bool,
    priority: Priority,
    created_at: u64,
    tags: [str],
}

/// Stan aplikacji
pub struct TodoState {
    todos: [Todo],
    next_id: u64,
    filter: str,
}

impl TodoState {
    pub fn new() -> TodoState {
        TodoState {
            todos: [],
            next_id: 1,
            filter: "all",
        }
    }

    pub fn visible(self) -> [Todo] {
        match self.filter {
            "active" => self.todos.filter(|t| not t.done),
            "done"   => self.todos.filter(|t| t.done),
            _        => self.todos,
        }
    }

    pub fn remaining_count(self) -> u64 {
        self.todos.filter(|t| not t.done).len() as u64
    }
}

/// Wynik operacji
pub struct OpResult {
    ok: bool,
    message: str,
    id: u64,
}

;; ─── Tauri Commands ───────────────────────────────────────────────────────────

pub async fn get_todos(filter: str, state: TodoState) -> [Todo] {
    state.visible()
}

pub async fn add_todo(
    text: str,
    priority: str,
    tags: [str],
    state: TodoState,
) -> OpResult {
    if text == "" {
        return OpResult { ok: false, message: "Tekst zadania nie może być pusty", id: 0 }
    }

    let prio = match priority {
        "high"     => Priority::High,
        "medium"   => Priority::Medium,
        "critical" => Priority::Critical,
        _          => Priority::Low,
    }

    let todo = Todo {
        id: state.next_id,
        text: text,
        done: false,
        priority: prio,
        created_at: 0,
        tags: tags,
    }

    state.todos.push(todo)
    state.next_id += 1

    OpResult { ok: true, message: "Dodano", id: state.next_id - 1 }
}

pub async fn toggle_todo(id: u64, state: TodoState) -> OpResult {
    var found: bool = false
    for todo in state.todos {
        if todo.id == id {
            let updated = Todo {
                id: todo.id,
                text: todo.text,
                done: not todo.done,
                priority: todo.priority,
                created_at: todo.created_at,
                tags: todo.tags,
            }
            todo = updated
            found = true
        }
    }
    if found {
        OpResult { ok: true, message: "Zaktualizowano", id: id }
    } else {
        OpResult { ok: false, message: "Nie znaleziono", id: id }
    }
}

pub async fn delete_todo(id: u64, state: TodoState) -> OpResult {
    let before = state.todos.len()
    state.todos.retain(|t| t.id != id)
    if state.todos.len() < before {
        OpResult { ok: true, message: "Usunięto", id: id }
    } else {
        OpResult { ok: false, message: "Nie znaleziono", id: id }
    }
}

pub async fn clear_done(state: TodoState) -> u64 {
    let before = state.todos.len() as u64
    state.todos.retain(|t| not t.done)
    before - state.todos.len() as u64
}

pub async fn get_stats(state: TodoState) -> TodoState {
    state
}

pub fn main() -> void! {
    tauri::Builder::default()
        .manage(TodoState::new())
        .invoke_handler(tauri::generate_handler![
            get_todos,
            add_todo,
            toggle_todo,
            delete_todo,
            clear_done,
            get_stats,
        ])
        .run(tauri::generate_context!())?
}
