use <qt>

pub struct CpuCore {
    id: u32,
    load: f64,
    freq_mhz: f64,
}

pub struct MemInfo {
    total_mb: u64,
    used_mb: u64,
    cached_mb: u64,
}

pub struct ProcessRow {
    pid: u32,
    name: str,
    cpu_pct: f64,
    mem_mb: u64,
    user: str,
}

pub struct SystemSnapshot {
    hostname: str,
    uptime_secs: u64,
    cores: [CpuCore],
    memory: MemInfo,
    processes: [ProcessRow],
}

pub struct SystemMonitor {
    snapshot: SystemSnapshot?,
    filter_query: str,
    refresh_ms: u32,
}

impl SystemMonitor {
    pub fn new() -> SystemMonitor {
        SystemMonitor {
            snapshot: nil,
            filter_query: "",
            refresh_ms: 1000,
        }
    }

    pub fn cpu_avg(self) -> f64 {
        match self.snapshot {
            nil  => 0.0,
            snap => {
                if snap.cores.len() == 0 {
                    return 0.0
                }
                var sum: f64 = 0.0
                for c in snap.cores {
                    sum += c.load
                }
                sum / snap.cores.len() as f64
            }
        }
    }

    pub fn mem_pct(self) -> f64 {
        match self.snapshot {
            nil  => 0.0,
            snap => {
                if snap.memory.total_mb == 0 {
                    return 0.0
                }
                snap.memory.used_mb as f64 / snap.memory.total_mb as f64 * 100.0
            }
        }
    }

    pub fn visible_processes(self) -> [ProcessRow] {
        match self.snapshot {
            nil  => [],
            snap => {
                if self.filter_query == "" {
                    snap.processes
                } else {
                    let q = self.filter_query
                    snap.processes.filter(|p| p.name.contains(q))
                }
            }
        }
    }
}

fn format_uptime(secs: u64) -> str {
    let days  = secs / 86400
    let hours = (secs % 86400) / 3600
    let mins  = (secs % 3600) / 60
    days.to_string() + "d " + hours.to_string() + "h " + mins.to_string() + "m"
}

pub fn main() -> void! {
    let app    = qt::QGuiApplication::new()
    let monitor = SystemMonitor::new()

    let engine = qt::QQmlApplicationEngine::new()
    engine.set_context_property("monitor", monitor)
    engine.load("qrc:/qml/main.qml")

    let timer = qt::QTimer::new()
    timer.set_interval(monitor.refresh_ms)
    timer.start()

    app.exec()?
}
