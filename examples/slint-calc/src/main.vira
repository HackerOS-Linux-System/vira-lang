use <slint>

pub struct CalcState {
    display: str,
    operand1: f64?,
    operand2: f64?,
    operator: str,
    result: f64?,
    error: str?,
    history: [str],
}

impl CalcState {
    pub fn new() -> CalcState {
        CalcState {
            display: "0",
            operand1: nil,
            operand2: nil,
            operator: "",
            result: nil,
            error: nil,
            history: [],
        }
    }

    pub fn display_value(self) -> f64 {
        self.display.parse_f64()
    }

    pub fn push_digit(self, digit: str) {
        if self.display == "0" or self.display == "" {
            self.display = digit
        } else {
            self.display = self.display + digit
        }
        self.error = nil
    }

    pub fn push_dot(self) {
        if not self.display.contains(".") {
            self.display = self.display + "."
        }
    }

    pub fn clear(self) {
        self.display   = "0"
        self.operand1  = nil
        self.operand2  = nil
        self.operator  = ""
        self.result    = nil
        self.error     = nil
    }

    pub fn backspace(self) {
        if self.display.len() > 1 {
            self.display = self.display.chars().take(self.display.len() - 1).collect()
        } else {
            self.display = "0"
        }
    }

    pub fn negate(self) {
        let val = self.display_value()
        self.display = (val * -1.0).to_string()
    }

    pub fn percent(self) {
        let val = self.display_value()
        self.display = (val / 100.0).to_string()
    }
}

fn format_result(val: f64) -> str {
    ;; Remove trailing zeros after decimal
    let s = val.to_string()
    if s.contains(".") and s.ends_with("0") {
        s.trim_end_matches('0').trim_end_matches('.').to_string()
    } else {
        s
    }
}

fn apply_op(a: f64, op: str, b: f64) -> f64! {
    match op {
        "+" => a + b,
        "-" => a - b,
        "*" => a * b,
        "/" => {
            if b == 0.0 {
                throw "Dzielenie przez zero"
            }
            a / b
        }
        "^" => {
            var result: f64 = 1.0
            var i: u32 = 0
            while i < b as u32 {
                result = result * a
                i += 1
            }
            result
        }
        _ => throw "Nieznany operator: " + op,
    }
}

;; ─── Slint-exposed functions ──────────────────────────────────────────────────

pub fn input_digit(state: CalcState, digit: str) {
    state.push_digit(digit)
}

pub fn input_dot(state: CalcState) {
    state.push_dot()
}

pub fn input_operator(state: CalcState, op: str) {
    if state.operator != "" and state.operand1 != nil {
        ;; Chain operation: compute current first
        let prev_result = apply_op(state.operand1!, state.operator, state.display_value())
        match prev_result {
            Ok(v) => {
                state.operand1 = v
                state.display  = format_result(v)
            }
            Err(e) => {
                state.error = e.to_string()
                return
            }
        }
    } else {
        state.operand1 = state.display_value()
    }
    state.operator = op
    state.display  = "0"
}

pub fn compute(state: CalcState) {
    let op = state.operator
    let a  = state.operand1
    let b  = state.display_value()

    match a {
        nil => return,
        val => {
            let r = apply_op(val, op, b)
            match r {
                Ok(result) => {
                    let expr = format_result(val) + " " + op + " " + format_result(b) + " = " + format_result(result)
                    state.history.push(expr)
                    state.result   = result
                    state.display  = format_result(result)
                    state.operand1 = nil
                    state.operator = ""
                }
                Err(e) => {
                    state.error   = e.to_string()
                    state.display = "Błąd"
                }
            }
        }
    }
}

pub fn calc_clear(state: CalcState) { state.clear() }
pub fn calc_backspace(state: CalcState) { state.backspace() }
pub fn calc_negate(state: CalcState) { state.negate() }
pub fn calc_percent(state: CalcState) { state.percent() }

pub fn get_display(state: CalcState) -> str { state.display }
pub fn get_history(state: CalcState) -> [str] { state.history }
pub fn get_error(state: CalcState) -> str? { state.error }

pub fn main() -> void! {
    let app = slint::Application::new()
    let calc = CalcState::new()

    app.run(calc)
}
