use <tauri>

pub struct Session {
    id: u64,
    title: str,
    cwd: str,
    history: [str],
    env: [(str, str)],
}

pub struct TermState {
    sessions: [Session],
    active_id: u64,
    next_id: u64,
}

impl TermState {
    pub fn new() -> TermState {
        TermState {
            sessions: [],
            active_id: 0,
            next_id: 1,
        }
    }
}

pub struct CmdResult {
    stdout: str,
    stderr: str,
    exit_code: i32,
    cwd: str,
}

;; ─── Commands ─────────────────────────────────────────────────────────────────

pub async fn new_session(title: str, cwd: str, state: TermState) -> Session {
    let session = Session {
        id: state.next_id,
        title: title,
        cwd: cwd,
        history: [],
        env: [],
    }
    state.sessions.push(session)
    state.active_id = state.next_id
    state.next_id += 1
    session
}

pub async fn list_sessions(state: TermState) -> [Session] {
    state.sessions
}

pub async fn close_session(id: u64, state: TermState) -> bool {
    let before = state.sessions.len()
    state.sessions.retain(|s| s.id != id)
    state.sessions.len() < before
}

;; Wykonaj komendę w sesji (przez std::process::Command)
pub async fn execute_command(
    session_id: u64,
    command: str,
    state: TermState,
) -> CmdResult! {
    if command == "" {
        throw "Pusta komenda"
    }

    ;; Znajdź sesję
    let session = state.sessions.find(|s| s.id == session_id)
    let cwd = match session {
        nil => "/home",
        s   => s.cwd,
    }

    ;; Rzeczywista implementacja użyłaby std::process::Command
    ;; Tu zwracamy placeholder
    for s in state.sessions {
        if s.id == session_id {
            s.history.push(command)
        }
    }

    CmdResult {
        stdout: "$ " + command + "\n[output tutaj]",
        stderr: "",
        exit_code: 0,
        cwd: cwd,
    }
}

pub async fn get_history(session_id: u64, state: TermState) -> [str] {
    let session = state.sessions.find(|s| s.id == session_id)
    match session {
        nil => [],
        s   => s.history,
    }
}

pub async fn change_dir(session_id: u64, path: str, state: TermState) -> str {
    for s in state.sessions {
        if s.id == session_id {
            let new_path = Session {
                id: s.id, title: s.title,
                cwd: path, history: s.history, env: s.env,
            }
            s = new_path
            return path
        }
    }
    "/home"
}

pub fn main() -> void! {
    tauri::Builder::default()
        .manage(TermState::new())
        .invoke_handler(tauri::generate_handler![
            new_session,
            list_sessions,
            close_session,
            execute_command,
            get_history,
            change_dir,
        ])
        .run(tauri::generate_context!())?
}
