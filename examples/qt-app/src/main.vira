use <qt:6>

// ─── Model danych ─────────────────────────────────────────────────────────────

/// Dane procesu
pub struct ProcessInfo {
    pid: u32,
    name: str,
    cpu_percent: f64,
    mem_kb: u64,
    status: ProcessStatus,
    user: str,
    command: str,
    threads: u32,
}

pub enum ProcessStatus {
    Running,
    Sleeping,
    Stopped,
    Zombie,
    Unknown,
}

/// Dane CPU
pub struct CpuInfo {
    core_id: u32,
    usage_percent: f64,
    frequency_mhz: f64,
    temperature_c: f64?,
}

/// Dane pamięci
pub struct MemInfo {
    total_kb: u64,
    used_kb: u64,
    free_kb: u64,
    buffers_kb: u64,
    cached_kb: u64,
    swap_total_kb: u64,
    swap_used_kb: u64,
}

/// Dane sieci
pub struct NetInterface {
    name: str,
    rx_bytes: u64,
    tx_bytes: u64,
    rx_packets: u64,
    tx_packets: u64,
    speed_mbps: f64?,
    is_up: bool,
}

/// Dane dysku
pub struct DiskInfo {
    device: str,
    mount: str,
    fs_type: str,
    total_kb: u64,
    used_kb: u64,
    free_kb: u64,
    read_kbps: f64,
    write_kbps: f64,
}

/// Snapshot całego systemu
pub struct SystemSnapshot {
    hostname: str,
    os_name: str,
    kernel: str,
    uptime_secs: u64,
    load_avg: (f64, f64, f64),
    cpus: [CpuInfo],
    memory: MemInfo,
    processes: [ProcessInfo],
    interfaces: [NetInterface],
    disks: [DiskInfo],
    timestamp: u64,
}

// ─── Qt Object — eksponowany do QML ───────────────────────────────────────────

/// Główny obiekt Qt — łączy backend (Vira/Rust) z frontendem (QML)
pub struct SystemMonitor {
    snapshot: SystemSnapshot?,
    refresh_interval_ms: u32,
    filter_query: str,
    sort_by: str,
    sort_asc: bool,
    selected_pid: u32,
    show_kernel_threads: bool,
}

impl SystemMonitor {
    pub fn new() -> SystemMonitor {
        SystemMonitor {
            snapshot: nil,
            refresh_interval_ms: 1000,
            filter_query: "",
            sort_by: "cpu",
            sort_asc: false,
            show_kernel_threads: false,
            selected_pid: 0,
        }
    }

    /// Odśwież dane systemowe
    pub fn refresh(self) -> void! {
        self.snapshot = collect_snapshot()?
    }

    /// Przefiltrowane i posortowane procesy
    pub fn visible_processes(self) -> [ProcessInfo] {
        let snap = match self.snapshot {
            nil  => return [],
            snap => snap,
        }

        var procs = snap.processes

        ;; filtruj procesy jądra jeśli ukryte
        if not self.show_kernel_threads {
            procs = procs.filter(|p| p.pid > 1 and not p.name.starts_with("["))
        }

        ;; filtruj po zapytaniu
        if self.filter_query != "" {
            let q = self.filter_query
            procs = procs.filter(|p|
                p.name.contains(q) or
                p.user.contains(q) or
                p.command.contains(q)
            )
        }

        ;; sortuj
        match self.sort_by {
            "cpu"  => procs.sort_by(|a, b| b.cpu_percent.partial_cmp(a.cpu_percent)),
            "mem"  => procs.sort_by(|a, b| b.mem_kb.cmp(a.mem_kb)),
            "pid"  => procs.sort_by(|a, b| a.pid.cmp(b.pid)),
            "name" => procs.sort_by(|a, b| a.name.cmp(b.name)),
            _      => procs,
        }
    }

    /// CPU usage string dla QML
    pub fn cpu_usage_str(self) -> str {
        match self.snapshot {
            nil => "--",
            snap => {
                let total_usage = snap.cpus.iter()
                    .map(|c| c.usage_percent)
                    .sum() / snap.cpus.len() as f64
                format_percent(total_usage)
            }
        }
    }

    /// Memory usage string dla QML
    pub fn mem_usage_str(self) -> str {
        match self.snapshot {
            nil => "--",
            snap => {
                let used_mb = snap.memory.used_kb / 1024
                let total_mb = snap.memory.total_kb / 1024
                used_mb.to_string() + " / " + total_mb.to_string() + " MB"
            }
        }
    }

    /// Wyślij sygnał SIGTERM do procesu
    pub fn kill_process(self, pid: u32) -> bool! {
        send_signal(pid, 15)?
        true
    }

    /// Wyślij sygnał SIGKILL do procesu
    pub fn force_kill_process(self, pid: u32) -> bool! {
        send_signal(pid, 9)?
        true
    }

    /// Zmień priorytet (nice) procesu
    pub fn renice_process(self, pid: u32, nice: i32) -> void! {
        set_nice(pid, nice)?
    }
}

// ─── Kolekcja danych systemowych ──────────────────────────────────────────────

/// Zbierz pełny snapshot systemu
fn collect_snapshot() -> SystemSnapshot! {
    ;; W pełnej implementacji: czyta /proc/stat, /proc/meminfo, /proc/net/dev itd.
    ;; Tutaj pokazujemy strukturę — rzeczywiste dane przez sys-info lub procfs crate

    SystemSnapshot {
        hostname: read_hostname()?,
        os_name: read_os_name()?,
        kernel: read_kernel_version()?,
        uptime_secs: read_uptime()?,
        load_avg: read_load_avg()?,
        cpus: collect_cpu_info()?,
        memory: collect_mem_info()?,
        processes: collect_processes()?,
        interfaces: collect_net_info()?,
        disks: collect_disk_info()?,
        timestamp: unix_now(),
    }
}

fn collect_processes() -> [ProcessInfo]! {
    ;; czyta /proc/<pid>/status, /proc/<pid>/stat, /proc/<pid>/cmdline
    []
}

fn collect_cpu_info() -> [CpuInfo]! {
    ;; czyta /proc/stat i /sys/devices/system/cpu/
    []
}

fn collect_mem_info() -> MemInfo! {
    ;; czyta /proc/meminfo
    MemInfo {
        total_kb: 0, used_kb: 0, free_kb: 0,
        buffers_kb: 0, cached_kb: 0,
        swap_total_kb: 0, swap_used_kb: 0,
    }
}

fn collect_net_info() -> [NetInterface]! { [] }
fn collect_disk_info() -> [DiskInfo]! { [] }

fn read_hostname() -> str! { "hackeros" }
fn read_os_name()  -> str! { "HackerOS" }
fn read_kernel_version() -> str! { "6.x.x-hackeros" }
fn read_uptime()   -> u64! { 0 }
fn read_load_avg() -> (f64, f64, f64)! { (0.0, 0.0, 0.0) }
fn unix_now()      -> u64  { 0 }

fn send_signal(pid: u32, sig: i32) -> void! {
    ;; libc::kill(pid, sig)
}

fn set_nice(pid: u32, nice: i32) -> void! {
    ;; libc::setpriority(...)
}

// ─── Formatowanie ─────────────────────────────────────────────────────────────

pub fn format_percent(v: f64) -> str {
    let rounded = (v * 10.0) as u64
    let int_part = rounded / 10
    let frac_part = rounded % 10
    int_part.to_string() + "." + frac_part.to_string() + "%"
}

pub fn format_bytes(kb: u64) -> str {
    if kb < 1024 {
        kb.to_string() + " KB"
    } elif kb < 1024 * 1024 {
        (kb / 1024).to_string() + " MB"
    } else {
        (kb / (1024 * 1024)).to_string() + " GB"
    }
}

pub fn uptime_str(secs: u64) -> str {
    let days  = secs / 86400
    let hours = (secs % 86400) / 3600
    let mins  = (secs % 3600) / 60
    days.to_string() + "d " + hours.to_string() + "h " + mins.to_string() + "m"
}

pub fn process_status_str(status: ProcessStatus) -> str {
    match status {
        ProcessStatus::Running  => "R",
        ProcessStatus::Sleeping => "S",
        ProcessStatus::Stopped  => "T",
        ProcessStatus::Zombie   => "Z",
        ProcessStatus::Unknown  => "?",
    }
}

// ─── Historyczne dane (wykresy) ───────────────────────────────────────────────

/// Bufor kołowy dla historii CPU/RAM (dla wykresów QML)
pub struct RingBuffer {
    data: [f64],
    capacity: u32,
    head: u32,
}

impl RingBuffer {
    pub fn new(capacity: u32) -> RingBuffer {
        RingBuffer {
            data: [],
            capacity: capacity,
            head: 0,
        }
    }

    pub fn push(self, value: f64) {
        if self.data.len() < self.capacity as usize {
            self.data.push(value)
        } else {
            self.data[self.head as usize] = value
            self.head = (self.head + 1) % self.capacity
        }
    }

    pub fn as_list(self) -> [f64] {
        ;; zwraca w kolejności od najstarszego do najnowszego
        self.data
    }

    pub fn average(self) -> f64 {
        if self.data.len() == 0 {
            return 0.0
        }
        var sum: f64 = 0.0
        for v in self.data { sum += v }
        sum / self.data.len() as f64
    }

    pub fn max(self) -> f64 {
        var m: f64 = 0.0
        for v in self.data {
            if v > m { m = v }
        }
        m
    }
}

// ─── Entry point ──────────────────────────────────────────────────────────────

pub fn main() -> void! {
    let app = qt::QGuiApplication::new()

    let monitor = SystemMonitor::new()

    ;; QML engine
    let engine = qt::QQmlApplicationEngine::new()
    engine.set_context_property("monitor", monitor)
    engine.load("qrc:/qml/main.qml")

    ;; Timer odświeżający dane
    let timer = qt::QTimer::new()
    timer.set_interval(monitor.refresh_interval_ms)
    timer.connect_timeout(|| {
        monitor.refresh()
        ;; emituj sygnał do QML
    })
    timer.start()

    app.exec()?
}
