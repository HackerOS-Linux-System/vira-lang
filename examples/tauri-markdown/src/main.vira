use <tauri>

pub struct Document {
    id: u64,
    title: str,
    content: str,
    path: str?,
    modified: bool,
    created_at: u64,
    word_count: u32,
}

pub struct AppState {
    documents: [Document],
    active_id: u64?,
    next_id: u64,
}

impl AppState {
    pub fn new() -> AppState {
        AppState {
            documents: [],
            active_id: nil,
            next_id: 1,
        }
    }
}

pub struct DocResult {
    ok: bool,
    message: str,
    id: u64,
}

;; ─── Helpers ──────────────────────────────────────────────────────────────────

fn count_words(text: str) -> u32 {
    if text == "" {
        return 0
    }
    text.split(" ").filter(|w| w != "").len() as u32
}

;; ─── Commands ─────────────────────────────────────────────────────────────────

pub async fn new_doc(state: AppState) -> Document {
    let doc = Document {
        id: state.next_id,
        title: "Nowy dokument",
        content: "",
        path: nil,
        modified: false,
        created_at: 0,
        word_count: 0,
    }
    state.documents.push(doc)
    state.next_id += 1
    state.active_id = state.next_id - 1
    doc
}

pub async fn list_docs(state: AppState) -> [Document] {
    state.documents
}

pub async fn get_doc(id: u64, state: AppState) -> Document? {
    state.documents.find(|d| d.id == id)
}

pub async fn update_doc(
    id: u64,
    title: str,
    content: str,
    state: AppState,
) -> DocResult {
    var found: bool = false
    for doc in state.documents {
        if doc.id == id {
            let wc = count_words(content)
            let updated = Document {
                id: doc.id,
                title: title,
                content: content,
                path: doc.path,
                modified: true,
                created_at: doc.created_at,
                word_count: wc,
            }
            doc = updated
            found = true
        }
    }
    if found {
        DocResult { ok: true, message: "Zapisano", id: id }
    } else {
        DocResult { ok: false, message: "Nie znaleziono dokumentu", id: id }
    }
}

pub async fn delete_doc(id: u64, state: AppState) -> DocResult {
    let before = state.documents.len()
    state.documents.retain(|d| d.id != id)
    if state.documents.len() < before {
        if state.active_id == id {
            state.active_id = nil
        }
        DocResult { ok: true, message: "Usunięto", id: id }
    } else {
        DocResult { ok: false, message: "Nie znaleziono", id: id }
    }
}

;; Eksportuj do HTML (prosta konwersja nagłówków i bold)
pub async fn export_html(id: u64, state: AppState) -> str! {
    let doc = state.documents.find(|d| d.id == id)
    match doc {
        nil  => throw "Dokument nie istnieje",
        d => {
            let html = d.content
                .replace("# ",    "<h1>").replace("\n", "</h1>\n")
                .replace("## ",   "<h2>").replace("**", "<strong>")
            "<html><body>" + html + "</body></html>"
        }
    }
}

pub fn main() -> void! {
    tauri::Builder::default()
        .manage(AppState::new())
        .invoke_handler(tauri::generate_handler![
            new_doc,
            list_docs,
            get_doc,
            update_doc,
            delete_doc,
            export_html,
        ])
        .run(tauri::generate_context!())?
}
