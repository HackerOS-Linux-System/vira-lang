use <gtk:4.0>

// ─── Model ────────────────────────────────────────────────────────────────────

/// Wpis w systemie plików
pub struct FileEntry {
    name: str,
    path: str,
    size: u64,
    is_dir: bool,
    is_hidden: bool,
    mime_type: str,
    modified: u64,
    permissions: u32,
}

/// Stan panelu plików
pub struct FilePanel {
    current_path: str,
    entries: [FileEntry],
    selected: [str],
    show_hidden: bool,
    sort_by: SortField,
    sort_asc: bool,
}

pub enum SortField {
    Name,
    Size,
    Modified,
    Type,
}

pub enum FileError {
    AccessDenied(str),
    NotFound(str),
    IoError(str),
}

impl FilePanel {
    pub fn new(path: str) -> FilePanel {
        FilePanel {
            current_path: path,
            entries: [],
            selected: [],
            show_hidden: false,
            sort_by: SortField::Name,
            sort_asc: true,
        }
    }

    pub fn visible_entries(self) -> [FileEntry] {
        if self.show_hidden {
            self.entries
        } else {
            self.entries.filter(|e| not e.is_hidden)
        }
    }

    pub fn selected_count(self) -> u32 {
        self.selected.len() as u32
    }

    pub fn total_size(self) -> u64 {
        var total: u64 = 0
        for entry in self.entries {
            if not entry.is_dir {
                total += entry.size
            }
        }
        total
    }
}

/// Stan zakładek (bookmarks)
pub struct Bookmark {
    name: str,
    path: str,
    icon: str,
}

/// Główny stan aplikacji
pub struct AppState {
    left_panel: FilePanel,
    right_panel: FilePanel,
    active_panel: u8,
    bookmarks: [Bookmark],
    clipboard: [str],
    clipboard_is_cut: bool,
    search_query: str,
}

impl AppState {
    pub fn new() -> AppState {
        AppState {
            left_panel: FilePanel::new("/home"),
            right_panel: FilePanel::new("/"),
            active_panel: 0,
            bookmarks: default_bookmarks(),
            clipboard: [],
            clipboard_is_cut: false,
            search_query: "",
        }
    }

    pub fn active(self) -> FilePanel {
        if self.active_panel == 0 { self.left_panel } else { self.right_panel }
    }
}

fn default_bookmarks() -> [Bookmark] {
    [
        Bookmark { name: "Strona domowa",  path: "/home",        icon: "user-home" },
        Bookmark { name: "Dokumenty",      path: "/home/docs",   icon: "folder-documents" },
        Bookmark { name: "Pobrane",        path: "/home/dl",     icon: "folder-download" },
        Bookmark { name: "HackerOS",       path: "/opt/hackeros",icon: "computer" },
        Bookmark { name: "Kosz",           path: "trash:///",    icon: "user-trash" },
    ]
}

