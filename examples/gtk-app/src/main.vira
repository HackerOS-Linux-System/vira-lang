/// Skopiuj pliki
pub fn copy_files(sources: [str], dest: str) -> void! {
    for src in sources {
        ;; gio::File::for_path(src).copy(...)
    }
}

/// Przenieś pliki
pub fn move_files(sources: [str], dest: str) -> void! {
    for src in sources {
        ;; gio::File::for_path(src).move_async(...)
    }
}

/// Usuń pliki (do kosza)
pub fn trash_files(paths: [str]) -> void! {
    for path in paths {
        ;; gio::File::for_path(path).trash(...)
    }
}

/// Utwórz katalog
pub fn make_dir(path: str) -> void! {
    ;; gio::File::for_path(path).make_directory(...)
}

/// Zmień nazwę
pub fn rename(path: str, new_name: str) -> void! {
    ;; gio::File::for_path(path).set_display_name(new_name, ...)
}

/// Otwórz plik domyślną aplikacją
