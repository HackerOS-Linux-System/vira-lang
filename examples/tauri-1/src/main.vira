;; examples/notes-app/src/main.vira
;;
;; HackerNotes — działająca aplikacja Tauri w Vira
;; Kompilacja: vira build examples/notes-app
;;

use <tauri>

;; ─── Model ────────────────────────────────────────────────────────────────────

/// Pojedyncza notatka
pub struct Note {
    id: u64,
    title: str,
    content: str,
    pinned: bool,
}

/// Wynik operacji na notatkach
pub struct NoteResult {
    ok: bool,
    message: str,
    note_id: u64,
}

;; ─── State (Tauri managed state) ─────────────────────────────────────────────

pub struct NotesState {
    notes: [Note],
    counter: u64,
}

impl NotesState {
    pub fn new() -> NotesState {
        NotesState {
            notes: [],
            counter: 1,
        }
    }
}

;; ─── Tauri commands ───────────────────────────────────────────────────────────

/// Pobierz wszystkie notatki
pub async fn list_notes(state: NotesState) -> [Note] {
    state.notes
}

/// Dodaj nową notatkę
pub async fn add_note(
    title: str,
    content: str,
    state: NotesState,
) -> NoteResult {
    if title == "" {
        return NoteResult {
            ok: false,
            message: "Tytuł nie może być pusty",
            note_id: 0,
        }
    }

    let id = state.counter
    let note = Note {
        id: id,
        title: title,
        content: content,
        pinned: false,
    }

    state.notes.push(note)
    state.counter += 1

    NoteResult {
        ok: true,
        message: "Notatka dodana",
        note_id: id,
    }
}

/// Usuń notatkę po id
pub async fn remove_note(id: u64, state: NotesState) -> NoteResult {
    let before = state.notes.len()
    state.notes.retain(|n| n.id != id)
    let removed = state.notes.len() < before

    if removed {
        NoteResult { ok: true, message: "Usunięto", note_id: id }
    } else {
        NoteResult { ok: false, message: "Nie znaleziono notatki", note_id: id }
    }
}

/// Przełącz pin notatki
pub async fn toggle_pin(id: u64, state: NotesState) -> NoteResult {
    var found: bool = false
    var new_pinned: bool = false

    for note in state.notes {
        if note.id == id {
            let updated = Note {
                id: note.id,
                title: note.title,
                content: note.content,
                pinned: not note.pinned,
            }
            note = updated
            found = true
            new_pinned = updated.pinned
        }
    }

    if found {
        let msg = if new_pinned { "Przypięto" } else { "Odpięto" }
        NoteResult { ok: true, message: msg, note_id: id }
    } else {
        NoteResult { ok: false, message: "Nie znaleziono", note_id: id }
    }
}

/// Wyszukaj notatki
pub async fn search_notes(query: str, state: NotesState) -> [Note] {
    if query == "" {
        return state.notes
    }
    state.notes.filter(|n| n.title.contains(query) or n.content.contains(query))
}

/// Zwróć liczbę notatek
pub async fn notes_count(state: NotesState) -> u64 {
    state.notes.len() as u64
}

;; ─── Entry point ──────────────────────────────────────────────────────────────

pub fn main() -> void! {
    let state = NotesState::new()

    tauri::Builder::default()
        .manage(state)
        .invoke_handler(tauri::generate_handler![
            list_notes,
            add_note,
            remove_note,
            toggle_pin,
            search_notes,
            notes_count,
        ])
        .run(tauri::generate_context!())?
}
